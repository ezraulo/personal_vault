    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/august/.local/share/uv/tools/rtfm-ai/bin/python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rtfm_sync.py",
            "timeout": 10
          }
        ]
      }
